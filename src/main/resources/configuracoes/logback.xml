<?xml version="1.0" encoding="UTF-8"?>
<!--Configuração de sistema de log-->
<configuration>
    <!--Registra o log no console-->
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <enconder>
            <pattern>
                <!--Formatação de mensagem de log-->
                %d{HH:mm:ss.SSS} %msg%n
            </pattern>
        </enconder>
    </appender>
    <!--Registra o log em um arquivo-->
    <appender name="FILE" class="ch.qos.logback.core.FileAppender">
        <file>out.log</file>
        <append>true</append>
        <enconder>
            <pattern>
                <!--Formatação de mensagem de log-->
                %d{HH:mm:ss.SSS} [%thread] %5-level %logger - %msg%n
            </pattern>
        </enconder>
    </appender>

    <root level="info">
        <append-ref ref="STDOUT"/>
    </root>
    <root level="trace">
        <append-ref ref="FILE"/>
    </root>
</configuration>
